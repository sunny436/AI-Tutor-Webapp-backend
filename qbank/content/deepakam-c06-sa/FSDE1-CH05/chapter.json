    {
     "concept_tag": "ekam-manavakulam",
     "learning_objective": "छात्रः गीते 'एक'-सङ्ख्यया वर्णितानि सूर्य-चन्द्र-मानवकुलानि अभिजानाति।"
    },
    {
     "concept_tag": "devah-sankhyah",
     "learning_objective": "छात्रः त्रिनयनमूर्तिः, चतुर्मुखः, षण्मुखः इति देवानां सङ्ख्यासम्बद्धानि वर्णनानि अवगच्छति।"
    },
    {
     "concept_tag": "pancha-angulyah",
     "learning_objective": "छात्रः 'पञ्चाङ्गुल्यः गणनां विदधति' इति पङ्क्तेः भावं व्याख्याति।"
    }
   ]
  },
