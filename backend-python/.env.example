# ============================================================
#  SETTINGS (template) for the Python AI backend
#
#  1. Copy this file and rename the copy to ".env"
#  2. Fill in the values
#
#  ".env" is git-ignored. Never commit real keys.
# ============================================================

# ---- Which AI provider ----
# "groq" (free cloud API, fast) or "openrouter" (free models, slower).
# Ollama was removed: it runs on CPU here and took ~167s per reply.
LLM_PROVIDER=groq

# ---- Groq (free cloud API) ----
# Free key from https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- OpenRouter (fallback provider) ----
# Free key from https://openrouter.ai/keys
# "Free" means $0 per token, NOT no account — a key is still required.
OPENROUTER_API_KEY=

# ---- Model fallback chain ----
# Tried in order; a model that fails or hits its quota is skipped and put on a
# cooldown, so one exhausted provider cannot take the whole app down.
#
# Format: provider:model, comma separated. The provider prefix is required
# because OpenRouter model ids legitimately contain colons of their own
# (e.g. "nvidia/nemotron-3-super-120b-a12b:free").
#
# Do NOT add small models here. `llama-3.1-8b-instant` was tried and it INVERTED
# intents — it classified health complaints as small talk, so users got chit-chat
# instead of a consultation. A degraded answer is worse than a clear error.
MODEL_CHAIN=groq:llama-3.3-70b-versatile,groq:openai/gpt-oss-120b,openrouter:google/gemma-4-26b-a4b-it:free,openrouter:nvidia/nemotron-3-super-120b-a12b:free

# The router decides intake vs answer vs small talk. It must be a capable model
# for the same reason as above.
ROUTER_MODEL=llama-3.3-70b-versatile
PRIMARY_MODEL=llama-3.3-70b-versatile

# Some free models take ~60s for a full answer, so this is deliberately generous.
LLM_TIMEOUT_SECONDS=150

# ---- Knowledge retrieval (RAG). No key needed; the model downloads once. ----
# bge-m3 is MULTILINGUAL on purpose. The old default, all-MiniLM-L6-v2, is
# English-only, which broke Hindi and Hinglish queries — "neend nahi aati" scored
# below the relevance threshold and retrieved nothing.
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_DB_DIR=data/vector_store
KNOWLEDGE_DIR=data/knowledge

# ---- Network exposure ----
# Bind loopback only. In production, cloudflared runs on the same machine and
# reaches this backend over 127.0.0.1, so nothing is lost — but the API stops
# being reachable from the LAN, and the only way in is through Cloudflare.
# Use 0.0.0.0 ONLY if another machine genuinely must call this backend directly.
HOST=127.0.0.1
PORT=4000

# Auto-restart on file change. Development only — leave 0 in production, where
# the reloader costs a second process and watches the whole directory including
# `.venv`.
RELOAD=0

# Browser origins allowed to call this API. Comma separated, no wildcards.
# Add the production hostname when the Cloudflare subdomain exists, e.g.
#   ALLOWED_ORIGINS=https://ayurveda.example.com,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- How this backend connects to the Convex template ----
# These two MUST match what is set on the Convex side:
#   npx convex env set BACKEND_SERVICE_KEY <same value as SERVICE_KEY>
#   npx convex env set BACKEND_WEBHOOK_SECRET <same value as WEBHOOK_SECRET>
SERVICE_KEY=
WEBHOOK_SECRET=

# Convex HTTP Actions URL — ends in .convex.site (NOT .convex.cloud).
# JWKS is served at <this>/.well-known/jwks.json and is how /whoami verifies a
# Convex login token.
CONVEX_SITE_URL=
CONVEX_AUDIENCE=convex

# ---- Developer tooling ----
# Enables GET /debug/retrieve (also service-key guarded) to inspect why a query
# retrieved a given note. MUST be 0 on any internet-facing deployment; the route
# returns 404 when disabled so it does not even advertise that it exists.
DEBUG_RAG=0

# ---- Behaviour ----
MAX_FOLLOWUPS=4
MAX_INTAKE_ROUNDS=2

# ---- Optional: text to speech ----
# Leave empty to disable the speak endpoint.
TTS_MODEL=
