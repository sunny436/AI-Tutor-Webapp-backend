# ============================================================
#  SETTINGS (template) for the Python AI backend
#
#  1. Copy this file and rename the copy to ".env"
#  2. Fill in the values
# ============================================================

# ---- Which free AI provider ----
# "groq" = free cloud API (recommended)   |   "ollama" = free local
LLM_PROVIDER=groq

# ---- Groq (free cloud API) ----
# Get a FREE key from https://console.groq.com
GROQ_API_KEY=your_free_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Ollama (only if LLM_PROVIDER=ollama) ----
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ---- Ayurveda/Yoga knowledge (RAG). No key needed; downloads once. ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_DIR=data/vector_store
KNOWLEDGE_DIR=data/knowledge

# ---- How this backend connects to the Convex template ----
PORT=4000
# These two secrets MUST match what you set on the Convex side:
#   npx convex env set BACKEND_SERVICE_KEY <same value as SERVICE_KEY>
#   (and the webhook secret used by the template)
SERVICE_KEY=choose-a-long-random-string
WEBHOOK_SECRET=choose-another-long-random-string
# Your Convex "site" URL (ends in .convex.site in the cloud, or local dev URL)
CONVEX_SITE_URL=http://localhost:3211
CONVEX_AUDIENCE=convex

# ---- Behaviour ----
MAX_FOLLOWUPS=4
