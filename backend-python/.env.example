# ============================================================
#  SETTINGS (template) for the Python AI backend
#
#  1. Copy this file and rename the copy to ".env"
#  2. Fill in the values
#
#  ".env" is git-ignored. Never commit real keys.
#
#  This backend has no local model and no local knowledge base. Every
#  consultation answer comes from GraphRAG's own /v1/answer. The only local
#  decision left is the safety keyword scan in src/safety.py, which runs
#  before GraphRAG is ever called and needs no configuration.
# ============================================================

# ---- GraphRAG (the only source of an answer) ----
# Credentials and setup instructions come from the vendor brief
# (docs/graphrag-api.md, git-ignored — ask whoever holds it).
GRAPHRAG_ENABLED=1
GRAPHRAG_BASE_URL=https://graphrag.internal
GRAPHRAG_API_KEY=
# Path to graphrag-internal-root.crt, OUTSIDE this repo.
GRAPHRAG_CA_BUNDLE=
GRAPHRAG_TOP_K=6
GRAPHRAG_ANSWER_TIMEOUT_S=120

# ---- Network exposure ----
# Bind loopback only. In production, cloudflared runs on the same machine and
# reaches this backend over 127.0.0.1 — the only way in is through Cloudflare.
HOST=127.0.0.1
PORT=4000

# Auto-restart on file change. Development only — leave 0 in production.
RELOAD=0

# Browser origins allowed to call this API. Comma separated, no wildcards.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Require a valid Convex login token on /consult and /consult/stream, so an
# anonymous caller cannot spend GraphRAG's metered quota.
REQUIRE_AUTH=1

# ---- How this backend connects to the Convex template ----
# These two MUST match what is set on the Convex side:
#   npx convex env set BACKEND_SERVICE_KEY <same value as SERVICE_KEY>
#   npx convex env set BACKEND_WEBHOOK_SECRET <same value as WEBHOOK_SECRET>
SERVICE_KEY=
WEBHOOK_SECRET=

# Convex HTTP Actions URL — ends in .convex.site (NOT .convex.cloud).
# JWKS is served at <this>/.well-known/jwks.json and is how /whoami verifies a
# Convex login token.
CONVEX_SITE_URL=
CONVEX_AUDIENCE=convex
