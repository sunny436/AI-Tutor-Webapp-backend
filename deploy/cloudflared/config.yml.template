# Cloudflare Tunnel ingress for the Ayurveda app.
#
# Generated by scripts in cloudflare/. Contains NO secrets -- the tunnel's
# credentials live in the file referenced below, outside this repository.
#
# The app and the API need separate hostnames because cloudflared forwards the
# full request path without stripping a prefix: a single host routing "/ai/*"
# would deliver "/ai/consult" to FastAPI, which has no such route.
tunnel: f1750626-199d-44fd-8dc2-c2d91beeb65f
credentials-file: /etc/cloudflared/TUNNEL_ID.json

# Do not buffer responses; the consult endpoint can take well over a minute.
originRequest:
  connectTimeout: 30s
  noTLSVerify: false

ingress:
  - hostname: ayur.namahos.com
    service: http://127.0.0.1:3000

  - hostname: ayur-api.namahos.com
    service: http://127.0.0.1:4000
    originRequest:
      # A full consultation can take ~150s on the free model tier.
      connectTimeout: 30s

  # Self-hosted Convex. Two hostnames because Convex serves the client API and
  # its HTTP actions on separate ports, and cloudflared forwards the full path
  # without stripping a prefix, so one host cannot carry both.
  #
  # The site host is load-bearing beyond Convex itself: auth.config.ts uses it
  # as the JWT issuer, and backend-python fetches
  # <site>/.well-known/jwks.json from it to verify every login token.
  - hostname: ayur-convex.namahos.com
    service: http://127.0.0.1:3210
    originRequest:
      # The browser holds a long-lived websocket here for live queries.
      connectTimeout: 30s

  - hostname: ayur-convex-http.namahos.com
    service: http://127.0.0.1:3211

  # Anything else reaching this tunnel is not ours. Refuse it rather than
  # letting an unexpected Host header through to a local service.
  - service: http_status:404
