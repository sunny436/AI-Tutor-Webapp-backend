# /etc/ayurveda/backend.env   -- chmod 600, NEVER in git
#
# The Python backend also reads backend-python/.env. Keep ONE of them
# authoritative; this file is the one systemd loads.

# ---- AI providers ----
# Chat, the router and every reasoning call run on OLLIMA. OpenRouter serves
# ONLY embeddings and speech-to-text - it is not a fallback for chat, and
# there is no cross-provider fallback at all. If Ollima is down, the product
# cannot answer; that is a deliberate choice, not an oversight.
#
# This file used to default LLM_PROVIDER to groq with a GROQ_API_KEY slot.
# Groq is gone from the stack; a deploy from that template would have sent
# every chat turn to a provider this project no longer uses.
LLM_PROVIDER=ollima
OLLIMA_API_KEY=
OLLIMA_BASE_URL=https://api.ollima.com/v1
OPENROUTER_API_KEY=

# Measured on the VM by scripts/eval_chain_models.py - see the comments in
# /etc/ayurveda/backend.env for the full table and the two rejected models.
PRIMARY_MODEL=ollima:gemini-3.1-flash-lite
ROUTER_MODEL=ollima:gemini-3.1-flash-lite
MODEL_CHAIN=ollima:gemini-3.1-flash-lite,ollima:gemini-3.5-flash-low

# OpenRouter, not local. Lowercase is the id OpenRouter serves.
EMBEDDING_MODEL=baai/bge-m3

# ---- Convex ----
# JWKS is fetched from ${CONVEX_SITE_URL}/.well-known/jwks.json to verify every
# login token. Must match CONVEX_SITE_ORIGIN in convex.env.
CONVEX_SITE_URL=https://ayur-convex-http.namahos.com
CONVEX_AUDIENCE=convex

# Must match BACKEND_SERVICE_KEY / BACKEND_WEBHOOK_SECRET on the Convex
# deployment. A mismatch shows up as 401s from the backend, not as a config
# error.
SERVICE_KEY=
WEBHOOK_SECRET=
