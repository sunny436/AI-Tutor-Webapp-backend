# /etc/ayurveda/convex.env   -- chmod 600, root:root, NEVER in git
#
# Read by deploy/compose/docker-compose.yml. These configure the CONTAINER.
# They are not the same as the Convex DEPLOYMENT variables (SITE_URL, SMTP_*,
# BACKEND_*, JWT_PRIVATE_KEY, JWKS), which live on the deployment itself and
# are set with `npx convex env set`.

# Public origins, served by the Cloudflare tunnel. No trailing slash, https.
# CONVEX_SITE_ORIGIN becomes CONVEX_SITE_URL inside Convex, and two things
# depend on it - auth.config.ts uses it as the JWT issuer, and the Python
# backend fetches <site>/.well-known/jwks.json from it to verify every login
# token. Both fail silently if it is wrong.
CONVEX_CLOUD_ORIGIN=https://ayur-convex.namahos.com
CONVEX_SITE_ORIGIN=https://ayur-convex-http.namahos.com

# INSTANCE_SECRET signs admin keys. Generate with: openssl rand -hex 32
# Changing it invalidates every admin key already issued.
INSTANCE_NAME=ayurveda
INSTANCE_SECRET=

# Empty = bundled SQLite in the docker volume. That volume IS the database:
# never `docker compose down -v`.
POSTGRES_URL=
DO_NOT_REQUIRE_SSL=

# Seconds a deleted/overwritten document stays recoverable. 14 days rather than
# the upstream default of 2 - the only cushion between a bad mutation and the
# last nightly backup.
DOCUMENT_RETENTION_DELAY=1209600
DISABLE_BEACON=true
DISABLE_METRICS_ENDPOINT=true
REDACT_LOGS_TO_CLIENT=true
