# /etc/aichat/api.env   -- chmod 600, NEVER in git. Loaded by aichat-api.service.
# Every setting is documented in backend-python/.env.example.
APP_ENV=production
APP_NAME=Assistant
LOG_LEVEL=INFO
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Same user/password/db as /etc/aichat/postgres.env
DATABASE_URL=postgresql+asyncpg://aichat:<password>@127.0.0.1:5432/aichat
# The web app's server-side proxy is the only caller and sets X-Forwarded-For.
TRUST_FORWARDED_FOR=true
ALLOWED_ORIGINS=

EMAIL_BACKEND=smtp
# Keep the quotes: systemd strips them, and they keep the file loadable from a shell.
EMAIL_FROM="Assistant <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
# Or the Ollastack Agent Mail API: set EMAIL_BACKEND=ollastack and the values below.
# The mailbox decides the sender address and name; EMAIL_FROM and SMTP_* are then unused.
OLLASTACK_BASE_URL=https://login.ollastack.com
OLLASTACK_TOKEN=
OLLASTACK_MAILBOX_ID=

LLM_PROVIDER=openai_compatible
LLM_PRIMARY_NAME=ollima
LLM_PRIMARY_BASE_URL=https://api.ollima.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_NAME=openrouter
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Retrieval (docs/rag.md). With no EMBEDDING_API_KEY retrieval is skipped and chat still works.
RAG_ENABLED=true
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Do NOT set LANGSMITH_* / LANGCHAIN_TRACING* variables: tracing would send prompts to an external service.
