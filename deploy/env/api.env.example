# /etc/aichat/api.env   -- chmod 600, NEVER in git. Loaded by aichat-api.service.
# Every setting is documented in backend/.env.example.
APP_ENV=production
APP_NAME=PadhAI
LOG_LEVEL=INFO
# Generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Shared with the web app (web.env, the same value): Better Auth asks the API to email sign-in and
# reset codes and to raise security notices (/internal/auth/*). At least 32 random characters.
AUTH_INTERNAL_TOKEN=
# Same user/password/db as /etc/aichat/postgres.env
DATABASE_URL=postgresql+asyncpg://aichat:<password>@127.0.0.1:5432/aichat
# The web app's server-side proxy is the only caller and sets X-Forwarded-For.
TRUST_FORWARDED_FOR=true
ALLOWED_ORIGINS=

EMAIL_BACKEND=smtp
# Keep the quotes: systemd strips them, and they keep the file loadable from a shell.
EMAIL_FROM="Assistant <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
# Or the Ollastack Agent Mail API: set EMAIL_BACKEND=ollastack and the values below.
# The mailbox decides the sender address and name; EMAIL_FROM and SMTP_* are then unused.
OLLASTACK_BASE_URL=https://login.ollastack.com
OLLASTACK_TOKEN=
OLLASTACK_MAILBOX_ID=

LLM_PROVIDER=openai_compatible
LLM_PRIMARY_NAME=ollima
LLM_PRIMARY_BASE_URL=https://api.ollima.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.1-flash-lite
LLM_FALLBACK_NAME=openrouter
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Retrieval (docs/rag.md). With no EMBEDDING_API_KEY retrieval is skipped and chat still works.
# Any OpenAI-compatible embeddings API (e.g. OpenRouter: https://openrouter.ai/api/v1). The model
# must return 1536 dimensions with the `dimensions` parameter (checked at startup and per batch).
RAG_ENABLED=true
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# File Library and chat attachments (app/files). Off stops uploads and processing only; ready
# attachments keep working and text chat never depends on files. Production parses files in a
# systemd sandbox ("auto"); with files available only when its self-test passes (/health "files").
FILES_ENABLED=true
FILES_EXTRACTOR=auto
# Teach the tutor the interactive practice blocks (quizzes, flashcards, graphs, file previews).
# The web app renders them either way; turning this on is an owner decision (docs/deployment.md).
TUTOR_INTERACTIVE_BLOCKS=false
# Teaching defaults for the tutor (app/chat/teaching.py); the student's own settings come first.
# Turning this on is an owner decision (docs/deployment.md).
TUTOR_TEACHING_POLICY=false
# The NCERT Knowledge Service as the tutor's knowledge source (app/rag/ncert.py): both set = on.
# Production: NCERT_KB_BASE_URL=http://127.0.0.1:4200 and the service's client key (a secret).
NCERT_KB_BASE_URL=
NCERT_KB_API_KEY=
NCERT_KB_TIMEOUT_S=6.0
# The intent router (app/intents, docs/deployment.md): off -> shadow -> on, each after its checks. It sends
# the message (at most 1,000 characters) to Ollalink, a third party. A mode other than off needs the key.
INTENT_ROUTER=off
OLLALINK_BASE_URL=https://ai.ollalink.com
OLLALINK_API_KEY=
INTENT_ROUTER_TIMEOUT_S=1.5
INTENT_MIN_CONFIDENCE=0.5
INTENT_MIN_GROUP_CONFIDENCE=0.5
# The study scope filter (app/intents/scope.py): off -> shadow -> on, each after its checks; the same key.
STUDY_SCOPE=off
SCOPE_MIN_REDIRECT=0.5
SCOPE_MIN_CONFIDENCE=0.5
OLLALINK_WARM_AFTER_S=45
# Do NOT set LANGSMITH_* / LANGCHAIN_TRACING* variables: tracing would send prompts to an external service.

# Jobs worker (python -m app.jobs, aichat-jobs.timer): docs/deployment.md, "Jobs worker".
JOBS_ENABLED=false
# off | dry_run | allowlist | on (student emails: security alerts and reminders)
NOTIFICATIONS_MODE=off
NOTIFICATIONS_ALLOWLIST=
NOTIFICATIONS_KINDS=
NOTIFICATIONS_MAX_PER_RUN=50
# the site's bare HTTPS origin, for links in emails (required once NOTIFICATIONS_MODE is not off)
PUBLIC_APP_URL=https://ayur.namahos.com
# support requests are forwarded here; empty = stored only
SUPPORT_EMAIL=
