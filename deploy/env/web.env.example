# /etc/aichat/web.env   -- chmod 600, NEVER in git. Loaded by aichat-web.service, and by the
# release build (NEXT_PUBLIC_* are baked into the frontend build; API_BASE_URL is read at runtime).
# The web app's server calls the API over loopback; browsers never call it directly.
# API_BASE_URL must be set: the frontend's built-in default (:4000) is the development port.
API_BASE_URL=http://127.0.0.1:4100
NEXT_PUBLIC_SITE_URL=https://<app-hostname>
NEXT_PUBLIC_SENTRY_DSN=
# PREVIEW_FEATURES=1 shows UI whose backend does not exist yet (sample data, controls marked
# "Soon"): for local and staging previews only. Leave it unset in production.
# PREVIEW_FEATURES=
# Sign-in (Better Auth in this web app; docs/deployment.md, "Sign-in"). All server-only: never
# NEXT_PUBLIC_. Generate secrets on the host (openssl rand -base64 48); never print them.
#   AUTH_DATABASE_URL    postgresql://aichat_auth:<password>@127.0.0.1:5432/aichat
#                        (the role migration 0012 grants identity tables only)
#   BETTER_AUTH_SECRET   signs the session cookie (rotating it signs everyone out)
#   AUTH_INTERNAL_TOKEN  the same value as in api.env (Better Auth -> API /internal/auth)
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET   optional; unset hides "Continue with Google".
#                        Redirect URI: https://<app-hostname>/api/auth/callback/google
#   TURNSTILE_SITE_KEY / TURNSTILE_SECRET_KEY   optional; unset turns the adaptive CAPTCHA off.
#                        Cloudflare Turnstile widget for the app's hostname (mode Managed).
AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=
AUTH_INTERNAL_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
