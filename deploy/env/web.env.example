# /etc/aichat/web.env   -- chmod 600, NEVER in git. Loaded by aichat-web.service.
# Applies only once the frontend repository has been migrated to this API.
# The web app's server calls the API over loopback; browsers never call it directly.
API_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_SITE_URL=https://<app-hostname>
NEXT_PUBLIC_SENTRY_DSN=
