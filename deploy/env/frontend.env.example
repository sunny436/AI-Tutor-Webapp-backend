# /etc/ayurveda/frontend.env   -- chmod 600, NEVER in git
#
# WARNING: every NEXT_PUBLIC_* value is compiled into the JS bundle at BUILD
# time, not read at runtime. Changing one here and restarting the service keeps
# serving the old value. Run `bun run build` first.
NEXT_PUBLIC_CONVEX_URL=https://ayur-convex.namahos.com
NEXT_PUBLIC_SITE_URL=https://ayur.namahos.com
NEXT_PUBLIC_AI_BACKEND_URL=https://ayur-api.namahos.com
NEXT_PUBLIC_BACKEND_URL=https://ayur-api.namahos.com

# mock = canned conversation, no network. local = the real Python backend.
NEXT_PUBLIC_CONSULT_PROVIDER=local
NEXT_PUBLIC_BOT_ID=ayurveda
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
