# /etc/aichat/postgres.env   -- chmod 600, root:root, NEVER in git
# Read by deploy/compose/docker-compose.yml and deploy/backup.sh.
POSTGRES_USER=aichat
# Generate: openssl rand -base64 36
POSTGRES_PASSWORD=
POSTGRES_DB=aichat
# Backups (deploy/backup.sh). The dumps share the database's disk: 7 days keeps up to ~9 of
# them (nightly + before each migration), within the disk with user files at their ceiling.
BACKUP_DIR=/var/backups/aichat
KEEP_DAYS=7
