# /etc/ayurveda/convex-cli.env   -- chmod 600, NEVER in git
#
# Points the convex CLI at the self-hosted deployment. Replaces CONVEX_DEPLOY_KEY.
# The admin key is unrestricted access to all data - treat it as a root password.
# Generate after the stack is up:
#   docker compose exec backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_URL=https://ayur-convex.namahos.com
CONVEX_SELF_HOSTED_ADMIN_KEY=
