[Unit]
# One run of the jobs worker (backend/app/jobs) from the production checkout /opt/aichat/app:
# email outbox, reminders, retention. Started every minute by aichat-jobs.timer; runs once, exits.
# - Installed but NOT enabled: enabling the timer is a deliberate step (docs/deployment.md,
#   "Jobs worker"). JOBS_ENABLED=false in api.env also makes a run a no-op.
# - A commit without the worker (a rollback to an older one) skips the run: see the Condition.
# - One run at a time: systemd never starts a oneshot unit that is still running, and the
#   worker holds a database lock.
Description=aichat jobs worker (one run)
Requires=aichat-postgres.service
After=aichat-postgres.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/aichat/app/backend/app/jobs/__main__.py

[Service]
Type=oneshot
WorkingDirectory=/opt/aichat/app/backend
EnvironmentFile=/etc/aichat/api.env
ExecStart=/opt/aichat/app/backend/.venv/bin/python -m app.jobs
TimeoutStartSec=300
MemoryMax=400M
NoNewPrivileges=yes
PrivateTmp=yes
