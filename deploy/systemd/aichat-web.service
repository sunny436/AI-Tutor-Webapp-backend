[Unit]
# Next.js web app, from the production checkout /opt/aichat/app (bun run deploy): it serves
# frontend/apps/app/.next, which deploy/server/update.sh builds beside the served build and
# swaps in. It reaches the API through API_BASE_URL in /etc/aichat/web.env (:4100), and runs on
# the checkout's pinned Node (.node-version, installed into /opt/aichat/runtime), never on
# whatever Node the system has.
Description=aichat web app (Next.js)
After=aichat-api.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aichat/app/frontend/apps/app
EnvironmentFile=/etc/aichat/web.env
ExecStart=/bin/sh -c 'PATH="/opt/aichat/runtime/node-v$$(cat /opt/aichat/app/.node-version)-linux-x64/bin:$$PATH" exec /root/.bun/bin/bun run start'
Restart=always
RestartSec=5
MemoryMax=900M

[Install]
WantedBy=multi-user.target
