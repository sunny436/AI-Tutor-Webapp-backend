[Unit]
# FastAPI chat API. Loopback only: the web app's server-side proxy is its only client.
Description=aichat chat API (FastAPI)
Requires=aichat-postgres.service
After=aichat-postgres.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aichat/backend/backend
EnvironmentFile=/etc/aichat/api.env
ExecStartPre=/opt/aichat/backend/backend/.venv/bin/python -m alembic upgrade head
ExecStart=/opt/aichat/backend/backend/.venv/bin/python -m uvicorn app.main:create_app --factory --host 127.0.0.1 --port 4100 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
# In-flight replies are persisted as 'cancelled' on shutdown; give them a moment.
KillSignal=SIGINT
TimeoutStopSec=20
MemoryMax=900M
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
