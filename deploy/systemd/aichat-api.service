[Unit]
# FastAPI chat API of the ACTIVE RELEASE: /opt/aichat/current -> releases/<commit>.
# Loopback only: the web app's server-side proxy is its only client.
# Migrations are NOT run here. deploy/server/release.sh runs them explicitly before a switch,
# so a rollback to an older release never tries to migrate a newer schema.
Description=aichat chat API (FastAPI)
Requires=aichat-postgres.service
After=aichat-postgres.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/aichat/current/backend
EnvironmentFile=/etc/aichat/api.env
ExecStart=/opt/aichat/current/backend/.venv/bin/python -m uvicorn app.main:create_app --factory --host 127.0.0.1 --port 4100 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
# In-flight replies are persisted as 'cancelled' on shutdown; give them a moment.
KillSignal=SIGINT
TimeoutStopSec=20
MemoryMax=900M
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
