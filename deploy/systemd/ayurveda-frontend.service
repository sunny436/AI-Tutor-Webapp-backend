[Unit]
# The Next.js production server. `next start`, never `next dev`.
Description=Ayurveda Next.js frontend
After=convex.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ayurveda/ayurveda-frontend/apps/app
EnvironmentFile=/etc/ayurveda/frontend.env
ExecStart=/root/.bun/bin/bun run start
Restart=always
RestartSec=10
MemoryMax=900M

# NEXT_PUBLIC_* values are compiled into the bundle, not read at runtime.
# Changing frontend.env therefore needs `bun run build` before a restart, or
# the old value keeps being served. See deploy/README.md.

[Install]
WantedBy=multi-user.target
