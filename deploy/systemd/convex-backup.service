[Unit]
# Convex Cloud snapshotted automatically. Self-hosted, nothing does - this is
# the only thing between a bad mutation and permanent loss.
Description=Convex snapshot export
After=convex.service
Requires=convex.service

[Service]
Type=oneshot
WorkingDirectory=/opt/ayurveda/ayurveda-frontend/packages/backend
EnvironmentFile=/etc/ayurveda/convex-cli.env
ExecStart=/opt/ayurveda/Ayurveda-/deploy/backup.sh
