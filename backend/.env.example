# Chat API settings (template). Copy to `.env` for local development.
# `.env` and every `.env.*` file except this one are git-ignored. Never commit real keys.
# In production these come from /etc/aichat/api.env (see deploy/).

# ---- process ----
# development | test | production
APP_ENV=development
APP_NAME=Assistant
# keep loopback: only the web app's server-side proxy calls this API
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=INFO
# Keys the HMAC of one-time email codes. Production: `python -c "import secrets;print(secrets.token_urlsafe(48))"`
SECRET_KEY=

# ---- database: PostgreSQL + pgvector (docker-compose.dev.yml locally) ----
DATABASE_URL=postgresql+asyncpg://aichat:aichat@127.0.0.1:5432/aichat

# ---- HTTP ----
# comma-separated browser origins; empty = no CORS
ALLOWED_ORIGINS=
# true only when reachable exclusively through a trusted proxy
TRUST_FORWARDED_FOR=false
MAX_BODY_BYTES=65536
# profile photo uploads only (the original file; stored re-encoded, at most 64 KB)
AVATAR_MAX_BYTES=5242880
# the day boundary for users who have not chosen a time zone (progress, streaks)
DEFAULT_TIMEZONE=Asia/Kolkata

# ---- email (Mailpit locally: http://127.0.0.1:8025) ----
# smtp | ollastack | memory (tests)
EMAIL_BACKEND=smtp
EMAIL_FROM=Assistant <no-reply@localhost>
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
# Or the Ollastack Agent Mail API: set EMAIL_BACKEND=ollastack and the values below.
# The mailbox decides the sender address and name; EMAIL_FROM and SMTP_* are then unused.
OLLASTACK_BASE_URL=https://login.ollastack.com
OLLASTACK_TOKEN=
OLLASTACK_MAILBOX_ID=

# ---- LLM (OpenAI-compatible providers) ----
# openai_compatible | fake (tests/offline only)
LLM_PROVIDER=openai_compatible
LLM_PRIMARY_NAME=ollima
LLM_PRIMARY_BASE_URL=https://api.ollima.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.1-flash-lite
LLM_PRIMARY_STREAM_USAGE=true
# Fallback: used only when the primary fails before its first token. Empty model = no fallback.
LLM_FALLBACK_NAME=openrouter
LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=4096
LLM_FIRST_TOKEN_TIMEOUT_S=60
LLM_TOTAL_TIMEOUT_S=180
# Total characters sent to the model per turn (system + retrieved context + history + new message).
LLM_MAX_INPUT_CHARS=48000

# ---- chat limits ----
CHAT_MAX_MESSAGE_CHARS=16000
CHAT_HISTORY_MAX_MESSAGES=50
CHAT_GENERATIONS_PER_MINUTE=20
CHAT_GENERATIONS_PER_DAY=500

# ---- RAG: LangGraph + LangChain retriever over PostgreSQL/pgvector (docs/rag.md) ----
RAG_ENABLED=true
RAG_TOP_K=5
# Cosine similarity floor; uncalibrated default - tune with scripts/eval_retrieval.py
RAG_MIN_SCORE=0.30
RAG_MAX_CONTEXT_CHARS=8000
RAG_RETRIEVAL_TIMEOUT_S=8
RAG_HNSW_EF_SEARCH=100
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_MAX_DOCUMENT_BYTES=5242880

# ---- embeddings (OpenAI-compatible /embeddings) ----
# openai_compatible | fake (deterministic keyword hashing; tests/offline only, refused in production)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Empty key = retrieval is skipped (reason embeddings_unconfigured); chat keeps working.
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Must equal the pgvector column (vector(1536)); changing it needs a migration + re-ingest.
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_S=20

# ---- user files: File Library and chat attachments (app/files) ----
# Off stops uploads and processing only; ready attachments keep working. Files are parsed in a
# child process: "auto" = a systemd sandbox in production, a plain subprocess elsewhere.
FILES_ENABLED=true
FILES_EXTRACTOR=auto
# Teach the tutor the interactive practice blocks (quizzes, flashcards, graphs, file previews).
# The web app renders them either way; turning this on is an owner decision (docs/deployment.md).
TUTOR_INTERACTIVE_BLOCKS=false
# Teaching defaults for the tutor (app/chat/teaching.py); the student's own settings come first.
# Turning this on is an owner decision (docs/deployment.md).
TUTOR_TEACHING_POLICY=false
# The NCERT Knowledge Service as the tutor's knowledge source (app/rag/ncert.py): both set = on.
# Production: NCERT_KB_BASE_URL=http://127.0.0.1:4200 and the service's client key (a secret).
NCERT_KB_BASE_URL=
NCERT_KB_API_KEY=
NCERT_KB_TIMEOUT_S=6.0
# The intent router (app/intents, docs/deployment.md): Ollalink's classification model reads which of 46
# intents each new message asks for, in up to two short requests (the group, then the intent within it).
# off | shadow (recorded, never applied) | on. Sent to Ollalink: the message (at most 1,000 characters),
# the kinds of attached files and, for a follow-up of six words or fewer, the message before it and the
# end of the tutor's reply. The key is a secret. The timeout covers both requests.
INTENT_ROUTER=off
OLLALINK_BASE_URL=https://ai.ollalink.com
OLLALINK_API_KEY=
INTENT_ROUTER_TIMEOUT_S=1.5
# both chosen by scripts/eval_intents.py on its dev split: the score P(group) x P(intent | group), and
# P(group) (below it, no second request)
INTENT_MIN_CONFIDENCE=0.5
INTENT_MIN_GROUP_CONFIDENCE=0.5
# The study scope filter (app/intents/scope.py): is the message something PadhAI helps with? One more
# Ollalink request (the same key, text and time limit as the router). off | shadow (recorded, never
# applied) | on (unrelated requests get the app's redirect; the tutor keeps to learning).
STUDY_SCOPE=off
# chosen by scripts/eval_scope.py on its dev split: P(unrelated) to redirect; P(support|unclear|mixed)
SCOPE_MIN_REDIRECT=0.5
SCOPE_MIN_CONFIDENCE=0.5
# While students use the app, one small warm-up to Ollalink after this many quiet seconds (0: never)
OLLALINK_WARM_AFTER_S=45

# Jobs worker (python -m app.jobs, aichat-jobs.timer): docs/deployment.md, "Jobs worker".
JOBS_ENABLED=false
# off | dry_run | allowlist | on (student emails: security alerts and reminders)
NOTIFICATIONS_MODE=off
NOTIFICATIONS_ALLOWLIST=
NOTIFICATIONS_KINDS=
NOTIFICATIONS_MAX_PER_RUN=50
# the site's address, for links in emails (required once NOTIFICATIONS_MODE is not off)
PUBLIC_APP_URL=
# support requests are forwarded here; empty = stored only
SUPPORT_EMAIL=
