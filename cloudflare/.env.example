# ============================================================
#  Cloudflare edge configuration (template)
#
#  1. Copy this file next to it and rename the copy to ".env"
#  2. Fill in the values
#
#  The real ".env" is git-ignored and MUST NOT be committed.
#  Values here are examples only — never paste a real token into this file.
# ============================================================

# ---- API token ----
# Create at: https://dash.cloudflare.com/profile/api-tokens
#   Create Token -> Create Custom Token
#
# Grant exactly these permissions and nothing more. A token limited this way
# cannot touch billing, cannot buy anything, and cannot read your other services:
#
#   Account | Cloudflare Tunnel | Edit    (create and manage the tunnel)
#   Zone    | DNS               | Edit    (create the two subdomain records)
#   Zone    | Zone              | Read    (list which domains are on the account)
#   Zone    | Zone Settings     | Edit    (optional: set SSL mode, HTTPS, HSTS)
#
# Leave "Zone Settings | Edit" out if you would rather click those toggles in the
# dashboard yourself.
CLOUDFLARE_API_TOKEN=

# ---- Account ----
# Dashboard -> open any domain -> scroll the right-hand column -> "Account ID"
CLOUDFLARE_ACCOUNT_ID=

# ---- Zone (the domain) ----
# The registrable domain that is already active on the Cloudflare account.
# Do NOT guess this: run `bun run cf:zones` (or ask the setup script) to list the
# zones the token can actually see, and copy one from that output.
CLOUDFLARE_ZONE_NAME=
CLOUDFLARE_ZONE_ID=

# ---- Public hostnames ----
# Two subdomains of the zone above, both served by ONE tunnel.
#
# The API needs its own hostname because cloudflared forwards the full request
# path without stripping a prefix — a single host routing "/ai/*" would deliver
# "/ai/consult" to FastAPI, which has no such route.
#
#   app  -> http://127.0.0.1:3000   (Next.js dashboard)
#   api  -> http://127.0.0.1:4000   (Python AI backend)
CLOUDFLARE_APP_HOSTNAME=
CLOUDFLARE_API_HOSTNAME=

# ---- Tunnel ----
# Filled in automatically once the named tunnel is created. The tunnel's own
# credentials are written to %USERPROFILE%\.cloudflared\<id>.json — outside this
# repository, so they cannot be committed by accident.
CLOUDFLARE_TUNNEL_NAME=ayurveda
CLOUDFLARE_TUNNEL_ID=
