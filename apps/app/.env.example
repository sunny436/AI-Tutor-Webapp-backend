# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NOTHING here is a real credential.
#
# The defaults below run the whole UI with NO backend at all: no Python, no
# API keys, no Convex account. Change nothing and `bun dev` works.
# ---------------------------------------------------------------------------

# Where consultation answers come from.
#   mock   canned conversation, in-process, no network        <- default
#   local  a running Python backend (needs NEXT_PUBLIC_AI_BACKEND_URL)
NEXT_PUBLIC_CONSULT_PROVIDER=mock

# Which bot this frontend is. The backend validates it; an unknown value is a 400.
NEXT_PUBLIC_BOT_ID=ayurveda

# Only used when NEXT_PUBLIC_CONSULT_PROVIDER=local.
NEXT_PUBLIC_AI_BACKEND_URL=http://localhost:4000

# Public origin. Canonical URLs and the sitemap are built from it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Convex — login, chat storage, settings.
#
# REQUIRED. The build fails without it: `src/env.mjs` validates it, and the
# Convex client is constructed at module load. There is no "leave it blank" path.
#
# Get one in about two minutes with YOUR OWN free project:
#
#     cd packages/backend && npx convex dev
#
# That creates a project on your account and prints the URL. Never point this at
# the production deployment.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CONVEX_URL=

# Optional. Leave blank unless you are testing these specific features.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
