# ============================================================
#  Dashboard app (Next.js) — template
#
#  Copy to ".env.local" and fill in. ".env*.local" is git-ignored.
#
#  IMPORTANT: every NEXT_PUBLIC_* value is baked into the browser bundle at
#  BUILD time. Two consequences:
#    1. Changing one needs a rebuild — restarting the server is not enough.
#    2. Anyone can read them in DevTools. Never put a secret behind this prefix.
# ============================================================

# ---- Convex (database + auth) ----  REQUIRED
# The deployment's .convex.cloud URL, from the Convex dashboard.
NEXT_PUBLIC_CONVEX_URL=

# ---- Python AI backend ----  REQUIRED
# Where the browser sends consult requests. Both point at the same server:
#   NEXT_PUBLIC_AI_BACKEND_URL - src/lib/consult/client.ts
#   NEXT_PUBLIC_BACKEND_URL    - src/lib/backend.config.ts (direct path, carries
#                                the Convex JWT)
# Locally this is http://localhost:4000. In production it is the API subdomain
# served by the Cloudflare Tunnel, e.g. https://ayurveda-api.example.com
NEXT_PUBLIC_AI_BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# ---- Central AI API ----  the replacement for backend-python
#
# Which brain answers a consultation:
#   local    the Python backend at NEXT_PUBLIC_AI_BACKEND_URL (default)
#   central  the shared company API, via our own /api/consult route
#
# Read at BUILD time, not at runtime, because it is NEXT_PUBLIC_ — so switching
# it needs `bun run build` before the restart, not just a restart.
#
# It ships as "local" deliberately. Swapping the whole AI brain on a live product
# is worth being able to undo in one line, and this is that line.
NEXT_PUBLIC_CONSULT_PROVIDER=local

# The other four are SERVER-ONLY: no NEXT_PUBLIC_ prefix, so Next.js will not
# inline them into the browser bundle. That is the whole point for the key —
# a key the browser holds is a key anyone can spend.
#
# CENTRAL_API_URL         full endpoint, e.g. https://api.example.com/v1/chat
# CENTRAL_APPLICATION_ID  identifies Ayurveda among the company's applications
# CENTRAL_PROMPT_ID       identifies this chatbot's prompt on that service
# CENTRAL_API_KEY         never commit this; .env.local is gitignored
CENTRAL_API_URL=
CENTRAL_APPLICATION_ID=
CENTRAL_PROMPT_ID=
CENTRAL_API_KEY=

# ---- Google sign-in ----  OPTIONAL
# The button stays hidden unless this is exactly "true" AND the Convex
# deployment has AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET set. Both are needed.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# ---- Analytics / error tracking ----  OPTIONAL
# All blank-safe: src/env.mjs treats them as optional.
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_SECRET_KEY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
