{
  "name": "@v1/app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-pdfjs.mjs && next dev -p 3000 -H 127.0.0.1",
    "build": "node scripts/copy-pdfjs.mjs && next build",
    "clean": "git clean -xdf .next .turbo node_modules",
    "lint": "biome lint",
    "format": "biome format --write .",
    "start": "next start -p 3000 -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./src",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@goujon/react-calendar-heatmap": "1.0.0-beta.1",
    "@v1/ui": "workspace:*",
    "@xyflow/react": "^12.12.0",
    "chart.js": "^4.5.1",
    "katex": "^0.18.7",
    "lucide-react": "^0.438.0",
    "mathjs": "^15.2.0",
    "mdast-util-directive": "^3.1.0",
    "mermaid": "^12.0.0",
    "micromark-extension-directive": "^4.0.0",
    "next": "14.2.35",
    "next-themes": "^0.3.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sentry/nextjs": "^8",
    "@types/bun": "^1.4.2",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@v1/typescript": "workspace:*",
    "typescript": "^5.5.4"
  }
}
