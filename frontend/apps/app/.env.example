# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. NOTHING here is a real credential.
# Mirrors deploy/env/web.env.example (repository root), the production template.
#
# Nothing is required: with this file empty the app builds, and at runtime it
# talks to the chat API on its contract address, http://127.0.0.1:4000.
# ---------------------------------------------------------------------------

# Where the chat API listens. SERVER-ONLY: browsers never call the API; the
# app's own /api/v1/* routes forward to it. Never prefix this with NEXT_PUBLIC_.
API_BASE_URL=http://127.0.0.1:4000

# The public origin of this app (absolute URLs in page metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Sentry is only bundled when this is set.
NEXT_PUBLIC_SENTRY_DSN=

# Optional. Build into a different directory, so a build can be verified
# without touching the one a running `next start` is serving:
#   NEXT_DIST_DIR=.next-verify bun run build
# NEXT_DIST_DIR=
