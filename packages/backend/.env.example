# ============================================================
#  Convex deployment variables — REFERENCE ONLY
#
#  Convex does NOT read this file. Its variables live on the deployment itself.
#  This file exists because they were previously set by hand with `convex env
#  set` and documented nowhere, so nobody could tell which ones a fresh
#  deployment needs.
#
#  Set each one with:
#      cd packages/backend
#      npx convex env set NAME "value"
#
#  List what is currently set (values are shown, so mind your screen):
#      npx convex env list
# ============================================================

# ---- Public URL of the dashboard ----  REQUIRED
# Used to build links inside auth emails. Must be the address a user actually
# visits, so in production this is the Cloudflare subdomain, not localhost.
SITE_URL=http://localhost:3000

# ---- Python AI backend ----  REQUIRED
# Convex calls the backend server-to-server for consult jobs and report extraction.
# This is reached from Convex's servers, so it must be a PUBLIC url — the API
# subdomain served by the Cloudflare Tunnel. localhost will not work here.
BACKEND_BASE_URL=

# Shared secrets. These MUST match backend-python/.env exactly:
#   BACKEND_SERVICE_KEY   <-> SERVICE_KEY
#   BACKEND_WEBHOOK_SECRET <-> WEBHOOK_SECRET
# A mismatch shows up as 401s from the backend, not as a config error.
BACKEND_SERVICE_KEY=
BACKEND_WEBHOOK_SECRET=

# ---- Email delivery (sign-in codes, password reset) ----  REQUIRED
# SMTP is the working path. Resend was tried first and only ever delivered to
# the account owner: without a verified domain it forces the sender
# onboarding@resend.dev and refuses every other recipient with
# "403 domain not verified", so no real user could receive a code.
#
# For Gmail: SMTP_PASS is a 16-character APP PASSWORD from
# https://myaccount.google.com/apppasswords — not the account password, and it
# requires 2-Step Verification to be on.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
AUTH_EMAIL_FROM=

# Legacy Resend path. Leave blank unless a domain has been verified with Resend.
RESEND_API_KEY=
RESEND_SENDER_EMAIL_AUTH=

# ---- Google sign-in ----  OPTIONAL
# From https://console.cloud.google.com/apis/credentials (OAuth 2.0 Client ID,
# type "Web application").
#
#   Authorised redirect URI:   https://<deployment>.convex.site/api/auth/callback/google
#   Authorised JS origins:     the SITE_URL above
#
# The redirect URI points at Convex, NOT at the app, so it does NOT change when
# the app moves to a new domain. Only the JS origin needs updating.
# The frontend also needs NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Set automatically by Convex ----
# Listed for reference; do not set by hand.
# CONVEX_SITE_URL

# ---- Optional integrations ----
POLAR_ORGANIZATION_TOKEN=
POLAR_WEBHOOK_SECRET=
LOOPS_FORM_ID=

# ---- Development only ----
# DEV_SEED enables seed helpers. Leave unset on any real deployment.
# VALIDATE_ENV=false skips startup env validation.
DEV_SEED=
VALIDATE_ENV=
